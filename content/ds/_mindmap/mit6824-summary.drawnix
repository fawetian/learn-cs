            },
            {
              "id": "rFBrB",
              "type": "mind_child",
              "data": {
                "topic": {
                  "children": [
                    {
                      "text": "两阶段锁"
                    }
                  ],
                  "type": "paragraph"
                }
              },
              "children": [
                {
                  "id": "JkAEr",
                  "type": "mind_child",
                  "data": {
                    "topic": {
                      "children": [
                        {
                          "text": "2PL"
                        }
                      ],
                      "type": "paragraph"
                    }
                  },
                  "children": [
                    {
                      "id": "RnYeZ",
                      "type": "mind_child",
                      "data": {
                        "topic": {
                          "children": [
                            {
                              "text": "expand phase：只申请锁，不释放锁"
                            }
                          ],
                          "type": "paragraph"
                        }
                      },
                      "children": []
                    },
                    {
                      "id": "cExFm",
                      "type": "mind_child",
                      "data": {
                        "topic": {
                          "children": [
                            {
                              "text": "shrinking phase：只释放锁，不申请锁"
                            }
                          ],
                          "type": "paragraph"
                        }
                      },
                      "children": []
                    },
                    {
                      "id": "KbhpR",
                      "type": "mind_child",
                      "data": {
                        "topic": {
                          "children": [
                            {
                              "text": "问题：级联终止；死锁（expand phase 获取锁顺序不对）"
                            }
                          ],
                          "type": "paragraph"
                        }
                      },
                      "children": []
                    }
                  ]
                },
                {
                  "id": "TFQHP",
                  "type": "mind_child",
                  "data": {
                    "topic": {
                      "children": [
                        {
                          "text": "C2PL（保守两阶段锁）"
                        }
                      ],
                      "type": "paragraph"
                    }
                  },
                  "children": [
                    {
                      "id": "cYSJK",
                      "type": "mind_child",
                      "data": {
                        "topic": {
                          "children": [
                            {
                              "text": "expand phase 一次获取所有锁，防止死锁"
                            }
                          ],
                          "type": "paragraph"
                        }
                      },
                      "children": []
                    }
                  ]
                },
                {
                  "id": "FNnNR",
                  "type": "mind_child",
                  "data": {
                    "topic": {
                      "children": [
                        {
                          "text": "S2PL（严格两阶段锁）"
                        }
                      ],
                      "type": "paragraph"
                    }
                  },
                  "children": [
                    {
                      "id": "AmRjb",
                      "type": "mind_child",
                      "data": {
                        "topic": {
                          "children": [
                            {
                              "text": "shrinking phase 释放共享锁，排它锁在事务结束后一次性释放"
                            }
                          ],
                          "type": "paragraph"
                        }
                      },
                      "children": []
                    },
                    {
                      "id": "CcKDY",
                      "type": "mind_child",
