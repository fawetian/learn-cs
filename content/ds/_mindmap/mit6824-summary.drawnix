              "children": [
                {
                  "id": "BGYbj",
                  "type": "mind_child",
                  "data": {
                    "topic": {
                      "children": [
                        {
                          "text": "读操作：无写操作时所有节点均可读；存在写操作时，dirty read 转发到 tail 读，否则正常读"
                        }
                      ],
                      "type": "paragraph"
                    }
                  },
                  "children": []
                },
                {
                  "id": "yDxkk",
                  "type": "mind_child",
                  "data": {
                    "topic": {
                      "children": [
                        {
                          "text": "写操作：从 head 链式传播到 tail"
                        }
                      ],
                      "type": "paragraph"
                    }
                  },
                  "children": []
                },
                {
                  "id": "FPEYF",
                  "type": "mind_child",
                  "data": {
                    "topic": {
                      "children": [
                        {
                          "text": "故障恢复：恢复后拼接到 tail，做数据强制恢复"
                        }
                      ],
                      "type": "paragraph"
                    }
                  },
                  "children": []
                }
              ]
            }
          ]
        },
